FLASK_SECRET_KEY = replace-me
KEYCLOAK_SERVER_URL=https://localhost:8080
KEYCLOAK_REALM=novasecure
KEYCLOAK_CLIENT_ID=iam-admin-portal
KEYCLOAK_CLIENT_SECRET=replace_me
KEYCLOAK_SERVICE_CLIENT_ID=iam-governance-service
KEYCLOAK_SERVICE_CLIENT_SECRET=replace-with-keycloak-service-client-secret
DATABASE_URI=postgresql+psycopg://governance:replace-me@localhost:5432/governance
# Linux local-development CA trust store.
# Required for locally trusted mkcert certificates.
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
